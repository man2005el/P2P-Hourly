# ==========================================================
# CONFIGURACIÓN DE VARIABLES DE ENTORNO - P2P HOURLY VERCEL
# ==========================================================

# 1. Seguridad del Cron Job
# Token de seguridad exigido por el endpoint /api/monitoreo.
# Debe ser configurado como header Authorization (Bearer <token>) o parámetro ?token=<token> en cron-job.org
CRON_SECRET=mi_super_secreto_cron_12345

# 2. Identificador de la Hoja de Cálculo de Google Sheets
# ID obtenido de la URL de tu Google Sheet: https://docs.google.com/spreadsheets/d/<SPREADSHEET_ID>/edit
SPREADSHEET_ID=tu_spreadsheet_id_aqui

# 3. Credenciales de Google Service Account
# Opción A (Recomendado para Vercel): Todo el contenido del archivo JSON de la Service Account en formato minificado (string de una sola línea)
GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...","private_key_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\\n...\\n-----END PRIVATE KEY-----\\n","client_email":"...","client_id":"...","auth_uri":"https://accounts.google.com/o/oauth2/auth","token_uri":"https://oauth2.googleapis.com/token","auth_provider_x509_cert_url":"https://www.googleapis.com/oauth2/v1/certs","client_x509_cert_url":"..."}

# Opción B (Útil para desarrollo local): Ruta al archivo JSON de credenciales en tu máquina
# GOOGLE_SERVICE_ACCOUNT_FILE=./service_account.json
